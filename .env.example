# Featherless AI explanation layer (optional). Copy to .env or export these variables in your shell.
# NEVER put a real key in this template file, and never commit a filled-in .env.
FEATHERLESS_API_KEY=
# Set this to the model supplied by the hackathon / your Featherless account. No default is assumed.
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
